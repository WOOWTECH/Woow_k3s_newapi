# ~/.config/apporo-newapi-sync/env  (chmod 600; read by scripts/apporo-sync-daily.sh)
# kubectl for woow-k3s. Use the sync's own kubeconfig (docs/APPORO-SYNC.md 〈排程〉,
# deploy/apporo-sync/rbac.yaml), not a cluster-admin context; add --server /
# --tls-server-name if the server address does not resolve on this host.
APPORO_SYNC_KUBECTL="kubectl --kubeconfig $HOME/.config/apporo-newapi-sync/kubeconfig"
APPORO_SYNC_STATE_DIR="$HOME/.local/state/apporo-newapi-sync"
# report = classify, hold and alert only (start here for a few days and read the alerts);
# apply = also write auto items and matured holds.
APPORO_SYNC_MODE=report
# Optional: the platform's own llm_pricing.py for the pricing gate (default: the built-in port).
#APPORO_SYNC_PLATFORM_PRICING="$HOME/path/to/woow_paas_platform/src/services/llm_pricing.py"
