# Alternative to the systemd timer (template; not installed). crontab -e on cluster1:
CRON_TZ=Asia/Taipei
30 10 * * * umask 077; mkdir -p "$HOME/.local/state/apporo-newapi-sync" && "$HOME/woow-repos/Woow_k3s_newapi/scripts/apporo-sync-daily.sh" >> "$HOME/.local/state/apporo-newapi-sync/daily.log" 2>&1 || python3 "$HOME/woow-repos/Woow_k3s_newapi/scripts/apporo_sync.py" failure-alert --reason "cron run failed"
